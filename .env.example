# Local development. On Cloud Run these come from infra/cloudbuild.backend.yaml and Secret Manager.
# Local GCP auth: gcloud auth application-default login   (no service-account key files)
GCP_PROJECT=
GCP_REGION=europe-west1
# vertex (needs Vertex Gen AI allowed on the project) | local (sentence-transformers in-process) | hash
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# For EMBEDDING_PROVIDER=local, use:
#   EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   EMBEDDING_DIM=384

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173

# Optional: when set, every non-webhook route requires header X-API-Key
API_KEY=

# firestore (default) or memory (no GCP; loads backend/samples/solutions.json)
STORE_BACKEND=firestore
