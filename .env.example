# Backend (TEAMPLAN §1.6). Kopieer naar .env; .env staat in .gitignore.
GCP_PROJECT=
GCP_REGION=europe-west1
# Lokaal: `gcloud auth application-default login` (ADC), geen sa-key.json nodig.
# Alleen invullen als je project toch een key vereist:
# GOOGLE_APPLICATION_CREDENTIALS=./sa-key.json
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Alleen lokaal true. Op Cloud Run false, anders is /demo/simulate-call een open schrijfingang.
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173

# Dashboard (frontend/.env). Waarden komen uit de output van infra/gcp_setup.sh.
# VITE_API_URL=http://localhost:8080
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_DEMO_MODE=true
