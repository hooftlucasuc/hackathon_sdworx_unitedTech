rules_version = '2';
// Het dashboard leest alleen, en alleen voor teamleden met de custom claim agent == true
// (toegekend met scripts/grant_access.py; de e-maillijst staat dus niet in de repo).
// Schrijven gebeurt uitsluitend door de backend via de server-SDK, die de rules omzeilt.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAgent() {
      return request.auth != null && request.auth.token.agent == true;
    }

    match /{collection}/{docId} {
      allow read: if isAgent() && collection in ['calls', 'callers', 'companies', 'solutions'];
      allow write: if false;
    }
  }
}
