rules_version = '2';
// Dashboard leest alleen, en alleen als ingelogde gebruiker (anoniem of Google).
// Schrijven gebeurt uitsluitend door de backend via de server-SDK, die rules omzeilt.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if request.auth != null
                  && collection in ['calls', 'callers', 'companies', 'solutions'];
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
