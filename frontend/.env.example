# Copy to .env.local (it is in .gitignore). Never commit real values.

# mock = dummy data in the browser, firestore = live from Firestore + B's API
VITE_DATA_SOURCE=mock

# Backend (Cloud Run or local)
VITE_API_BASE=http://localhost:8080

# Shows the demo menu that calls POST /demo/simulate-call
VITE_DEMO_MODE=true

# Firebase web config of the GCP project (Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = sign in anonymously first, so the Firestore rules can require "request.auth != null"
VITE_FIREBASE_ANON_AUTH=false
