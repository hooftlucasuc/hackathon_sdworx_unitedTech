# Kopieer naar .env.local (staat in .gitignore). Nooit echte waarden committen.

# mock = dummydata in de browser, firestore = realtime uit Firestore + API van B
VITE_DATA_SOURCE=mock

# Backend (Cloud Run of lokaal)
VITE_API_BASE=http://localhost:8080

# Toont de demo-knoppen die POST /demo/simulate-call aanroepen
VITE_DEMO_MODE=true

# Firebase web-config van het GCP-project (Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = eerst anoniem aanmelden, zodat de Firestore-rules "request.auth != null" kunnen eisen
VITE_FIREBASE_ANON_AUTH=false
